{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "private-downloads",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-25",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "downloads.example.com",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOWNLOADS",
      "bucket_name": "private-downloads"
    }
  ],
  "observability": {
    "enabled": false
  },
  "limits": {
    "cpu_ms": 10
  }
}
